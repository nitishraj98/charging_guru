# ── App ───────────────────────────────────────────────
CG_ENV=local
CG_DEBUG=true
CG_PROJECT_NAME=Charging Guru API
CG_API_V1_PREFIX=/api/v1

# ── Database (async) ──────────────────────────────────
CG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/charging_guru
# Optional read replica; falls back to primary if unset
CG_DATABASE_REPLICA_URL=

# ── Redis ─────────────────────────────────────────────
# Used for: rate limiting, distributed locks, availability cache, pub/sub (WS)
CG_REDIS_URL=redis://redis:6379/0

# ── Auth / JWT ────────────────────────────────────────
# HS256 for local dev (set a strong secret ≥ 32 chars).
# In production set CG_JWT_ALGORITHM=RS256 and supply PEM key pair.
CG_JWT_ALGORITHM=HS256
CG_JWT_SECRET=dev-only-change-me-please-32chars-min
CG_ACCESS_TOKEN_TTL_SECONDS=900
CG_REFRESH_TOKEN_TTL_SECONDS=2592000
# Pepper mixed into OTP/refresh-token hashes
CG_HASH_PEPPER=dev-pepper-change-me

# ── OTP ───────────────────────────────────────────────
CG_OTP_TTL_SECONDS=300
CG_OTP_MAX_ATTEMPTS=5
CG_OTP_LENGTH=6
# DEV ONLY — returns OTP in API response and logs it. Set false in prod!
CG_OTP_DEBUG=true

# ── Rate limits (per identity, sliding window) ────────
CG_RL_OTP_REQUESTS_PER_HOUR=5
CG_RL_OTP_VERIFY_PER_10MIN=10

# ── CORS ──────────────────────────────────────────────
CG_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Razorpay ──────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_*) locally; live keys (rzp_live_*) in prod.
CG_RAZORPAY_KEY_ID=rzp_test_placeholder
CG_RAZORPAY_KEY_SECRET=placeholder_secret_min_32_chars_____
# Webhook secret from Razorpay Dashboard → Webhooks → your endpoint → Secret
CG_RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret__________
