    {
      "name": "🏗️ Stations",
      "item": [
        {
          "name": "Discover Nearby Stations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations?lat=28.6280&lng=77.3649&radius_km=10",
              "host": ["{{base_url}}"],
              "path": ["api","v1","stations"],
              "query": [
                { "key": "lat",       "value": "28.6280" },
                { "key": "lng",       "value": "77.3649" },
                { "key": "radius_km", "value": "10" }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "var r = pm.response.json();",
                "if (r.length > 0) {",
                "  pm.collectionVariables.set('station_id', r[0].id);",
                "  console.log('station_id saved:', r[0].id);",
                "  pm.test('has distance_km', () => pm.expect(r[0].distance_km).to.be.a('number'));",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Get Station Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/stations/{{station_id}}", "host": ["{{base_url}}"], "path": ["api","v1","stations","{{station_id}}"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "var r = pm.response.json();",
                "if (r.chargers && r.chargers.length > 0) {",
                "  pm.collectionVariables.set('charger_id', r.chargers[0].id);",
                "  console.log('charger_id saved:', r.chargers[0].id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Create Station (Owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PowerHub Connaught Place\",\n  \"address\": \"1 Connaught Place, New Delhi\",\n  \"city\": \"New Delhi\",\n  \"state\": \"Delhi\",\n  \"pincode\": \"110001\",\n  \"lat\": 28.6315,\n  \"lng\": 77.2167,\n  \"amenities\": [\"cafe\", \"parking\", \"restroom\"],\n  \"chargers\": [\n    {\n      \"label\": \"Bay A1\",\n      \"charger_type\": \"DC\",\n      \"power_kw\": 50,\n      \"connector_type\": \"CCS2\",\n      \"price_per_kwh\": 1500\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/owner/stations", "host": ["{{base_url}}"], "path": ["api","v1","owner","stations"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"], "type": "text/javascript" } }]
        },
        {
          "name": "Update Charger Status (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"MAINTENANCE\",\n  \"reason\": \"Scheduled firmware upgrade\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/chargers/{{charger_id}}/status", "host": ["{{base_url}}"], "path": ["api","v1","chargers","{{charger_id}}","status"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/chargers/{{charger_id}}/slots", "host": ["{{base_url}}"], "path": ["api","v1","chargers","{{charger_id}}","slots"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "var slots = pm.response.json();",
                "pm.test('32 slots (06:00-22:00 @ 30min)', () => pm.expect(slots.length).to.equal(32));",
                "var available = slots.filter(s => s.available);",
                "if (available.length > 0) {",
                "  pm.collectionVariables.set('slot_start', available[0].slot_start);",
                "  console.log('slot_start saved:', available[0].slot_start);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },

    {
      "name": "📅 Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": [
                "// Set slot_start to tomorrow 10:00 UTC if not already set by slot endpoint",
                "if (!pm.collectionVariables.get('slot_start')) {",
                "  var d = new Date();",
                "  d.setDate(d.getDate() + 1);",
                "  d.setUTCHours(10, 0, 0, 0);",
                "  pm.collectionVariables.set('slot_start', d.toISOString());",
                "}"
              ],
              "type": "text/javascript"
            }
          }, {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 201', () => pm.response.to.have.status(201));",
                "var r = pm.response.json();",
                "pm.collectionVariables.set('booking_id', r.id);",
                "console.log('booking_id saved:', r.id);",
                "pm.test('PENDING_PAYMENT', () => pm.expect(r.status).to.equal('PENDING_PAYMENT'));",
                "pm.test('amount is integer paise', () => pm.expect(r.amount).to.be.a('number'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization",  "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "Idempotency-Key","value": "{{$guid}}", "description": "Prevents duplicate bookings on retry" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"charger_id\": \"{{charger_id}}\",\n  \"slot_start\": \"{{slot_start}}\",\n  \"duration_minutes\": 30\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/bookings", "host": ["{{base_url}}"], "path": ["api","v1","bookings"] }
          }
        },
        {
          "name": "List My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/bookings", "host": ["{{base_url}}"], "path": ["api","v1","bookings"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('array', () => pm.expect(pm.response.json()).to.be.an('array'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}", "host": ["{{base_url}}"], "path": ["api","v1","bookings","{{booking_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }]
        }
      ]
    },

    {
      "name": "💳 Payments",
      "description": "Full Razorpay payment lifecycle.\n\nIn local dev (CG_OTP_DEBUG=true) the Razorpay calls hit the real gateway — use test credentials.\n\nFlow: Create Order → (user pays in SDK) → Verify → booking becomes CONFIRMED + qr_token issued.",
      "item": [
        {
          "name": "1. Create Payment Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/payments/order", "host": ["{{base_url}}"], "path": ["api","v1","payments","order"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 201', () => pm.response.to.have.status(201));",
                "var r = pm.response.json();",
                "pm.collectionVariables.set('razorpay_order_id', r.razorpay_order_id);",
                "console.log('razorpay_order_id saved:', r.razorpay_order_id);",
                "pm.test('PENDING status', () => pm.expect(r.status).to.equal('PENDING'));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "2. Verify Payment (client-side)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"{{razorpay_order_id}}\",\n  \"razorpay_payment_id\": \"pay_REPLACE_WITH_ACTUAL\",\n  \"razorpay_signature\": \"REPLACE_WITH_ACTUAL_SIGNATURE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/payments/verify", "host": ["{{base_url}}"], "path": ["api","v1","payments","verify"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "var r = pm.response.json();",
                "if (r.qr_token) {",
                "  pm.collectionVariables.set('qr_token', r.qr_token);",
                "  console.log('qr_token saved (length):', r.qr_token.length);",
                "}",
                "pm.test('CONFIRMED', () => pm.expect(r.booking_status).to.equal('CONFIRMED'));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "3. Razorpay Webhook (simulate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",          "value": "application/json" },
              { "key": "X-Razorpay-Signature",  "value": "REPLACE_WITH_HMAC_SHA256_OF_BODY" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_test_001\",\n        \"order_id\": \"{{razorpay_order_id}}\"\n      }\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/payments/webhook", "host": ["{{base_url}}"], "path": ["api","v1","payments","webhook"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200 (idempotent)', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "Get Payment by Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/payments/booking/{{booking_id}}", "host": ["{{base_url}}"], "path": ["api","v1","payments","booking","{{booking_id}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "Cancel & Refund Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/payments/{{booking_id}}/refund", "host": ["{{base_url}}"], "path": ["api","v1","payments","{{booking_id}}","refund"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('CANCELLED', () => pm.expect(pm.response.json().status).to.equal('CANCELLED'));"], "type": "text/javascript" } }]
        }
      ]
    },

    {
      "name": "📱 QR",
      "description": "Owner scans user's QR at the station → booking transitions CONFIRMED → CHECKED_IN.\nRequires ROLE_STATION_OWNER or ROLE_ADMIN.",
      "item": [
        {
          "name": "Verify QR (check-in)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_token\": \"{{qr_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/qr/verify", "host": ["{{base_url}}"], "path": ["api","v1","qr","verify"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('CHECKED_IN', () => pm.expect(pm.response.json().status).to.equal('CHECKED_IN'));"], "type": "text/javascript" } }]
        }
      ]
    },

    {
      "name": "⚡ Sessions",
      "description": "Owner controls the physical charging session lifecycle.\nRequires ROLE_STATION_OWNER or ROLE_ADMIN.\n\nFlow: QR Verify (CHECKED_IN) → Start → (charging) → Complete",
      "item": [
        {
          "name": "Start Charging Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/sessions/{{booking_id}}/start", "host": ["{{base_url}}"], "path": ["api","v1","sessions","{{booking_id}}","start"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('IN_PROGRESS', () => pm.expect(pm.response.json().status).to.equal('IN_PROGRESS'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Complete Charging Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/sessions/{{booking_id}}/complete", "host": ["{{base_url}}"], "path": ["api","v1","sessions","{{booking_id}}","complete"] }
