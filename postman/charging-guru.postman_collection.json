          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('COMPLETED', () => pm.expect(pm.response.json().status).to.equal('COMPLETED'));"], "type": "text/javascript" } }]
        }
      ]
    },

    {
      "name": "👑 Admin",
