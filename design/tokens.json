{
  "$schema": "https://schemas.tokens.studio/latest/tokens-schema.json",
  "_meta": {
    "name": "Charging Guru Design Tokens",
    "format": "W3C Design Tokens / Tokens Studio compatible",
    "usage": "Import via the Tokens Studio Figma plugin. 'global' holds primitives; 'dark' and 'light' are semantic theme sets."
  },
  "global": {
    "color": {
      "volt": {
        "50":  { "$type": "color", "$value": "#E6FFF2" },
        "100": { "$type": "color", "$value": "#B3FFD9" },
        "200": { "$type": "color", "$value": "#80FFBF" },
        "300": { "$type": "color", "$value": "#4DFFA6" },
        "400": { "$type": "color", "$value": "#26F593" },
        "500": { "$type": "color", "$value": "#00E676" },
        "600": { "$type": "color", "$value": "#00C766" },
        "700": { "$type": "color", "$value": "#00A455" },
        "800": { "$type": "color", "$value": "#007D41" },
        "900": { "$type": "color", "$value": "#00532B" }
      },
      "carbon": {
        "1000": { "$type": "color", "$value": "#050708" },
        "950":  { "$type": "color", "$value": "#0A0D0E" },
        "900":  { "$type": "color", "$value": "#101415" },
        "800":  { "$type": "color", "$value": "#181D1F" },
        "700":  { "$type": "color", "$value": "#222829" },
        "600":  { "$type": "color", "$value": "#2E3638" },
        "500":  { "$type": "color", "$value": "#495154" },
        "400":  { "$type": "color", "$value": "#6B7479" },
        "300":  { "$type": "color", "$value": "#98A1A6" },
        "200":  { "$type": "color", "$value": "#C2C9CD" },
        "100":  { "$type": "color", "$value": "#E6EBED" },
        "0":    { "$type": "color", "$value": "#FFFFFF" }
      },
      "cyan":   { "400": { "$type": "color", "$value": "#4DDFF2" }, "500": { "$type": "color", "$value": "#22D3EE" }, "700": { "$type": "color", "$value": "#0E9DB5" } },
      "amber":  { "500": { "$type": "color", "$value": "#FFC043" } },
      "orange": { "500": { "$type": "color", "$value": "#FF7849" } },
      "red":    { "500": { "$type": "color", "$value": "#FF5A5F" } }
    },
    "spacing": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" }
    },
    "radius": {
      "xs": { "$type": "dimension", "$value": "8px" },
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "28px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "typography": {
      "displayXl": { "$type": "typography", "$value": { "fontFamily": "Satoshi", "fontWeight": 600, "fontSize": "40px", "lineHeight": "44px", "letterSpacing": "-2%" } },
      "display":   { "$type": "typography", "$value": { "fontFamily": "Satoshi", "fontWeight": 600, "fontSize": "32px", "lineHeight": "38px", "letterSpacing": "-2%" } },
      "h1":        { "$type": "typography", "$value": { "fontFamily": "Satoshi", "fontWeight": 600, "fontSize": "28px", "lineHeight": "34px", "letterSpacing": "-1%" } },
      "h2":        { "$type": "typography", "$value": { "fontFamily": "Satoshi", "fontWeight": 600, "fontSize": "24px", "lineHeight": "30px" } },
      "h3":        { "$type": "typography", "$value": { "fontFamily": "Satoshi", "fontWeight": 600, "fontSize": "20px", "lineHeight": "26px" } },
      "title":     { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 600, "fontSize": "18px", "lineHeight": "24px" } },
      "bodyLg":    { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "16px", "lineHeight": "24px" } },
      "body":      { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px" } },
      "caption":   { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "12px", "lineHeight": "16px" } },
      "overline":  { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "8%", "textCase": "uppercase" } },
      "micro":     { "$type": "typography", "$value": { "fontFamily": "Inter", "fontWeight": 500, "fontSize": "11px", "lineHeight": "14px" } },
      "metric":    { "$type": "typography", "$value": { "fontFamily": "Geist Mono", "fontWeight": 500, "fontSize": "24px", "lineHeight": "28px" } }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" },
      "xl":   { "$type": "duration", "$value": "480ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "decel":    { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
      "spring":   { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
    }
  },
  "dark": {
    "bg":             { "$type": "color", "$value": "{global.color.carbon.950}" },
    "surface":        { "$type": "color", "$value": "{global.color.carbon.900}" },
    "surfaceRaised":  { "$type": "color", "$value": "{global.color.carbon.800}" },
    "border":         { "$type": "color", "$value": "{global.color.carbon.700}" },
    "borderStrong":   { "$type": "color", "$value": "{global.color.carbon.600}" },
    "textPrimary":    { "$type": "color", "$value": "{global.color.carbon.100}" },
    "textSecondary":  { "$type": "color", "$value": "{global.color.carbon.300}" },
    "textTertiary":   { "$type": "color", "$value": "{global.color.carbon.400}" },
    "textDisabled":   { "$type": "color", "$value": "{global.color.carbon.500}" },
    "accent":         { "$type": "color", "$value": "{global.color.volt.500}" },
    "onAccent":       { "$type": "color", "$value": "{global.color.carbon.1000}" },
    "focusRing":      { "$type": "color", "$value": "{global.color.volt.400}" },
    "status": {
      "available":   { "$type": "color", "$value": "{global.color.volt.500}" },
      "booked":      { "$type": "color", "$value": "{global.color.amber.500}" },
      "occupied":    { "$type": "color", "$value": "{global.color.cyan.500}" },
      "offline":     { "$type": "color", "$value": "{global.color.carbon.500}" },
      "maintenance": { "$type": "color", "$value": "{global.color.orange.500}" }
    },
    "effect": {
      "glassFill":   { "$type": "color", "$value": "rgba(16,20,21,0.72)" },
      "glassStroke": { "$type": "color", "$value": "rgba(255,255,255,0.08)" },
      "shadowMd":    { "$type": "shadow", "$value": { "color": "rgba(0,0,0,0.45)", "type": "dropShadow", "x": 0, "y": 8, "blur": 24, "spread": 0 } },
      "glowVolt":    { "$type": "shadow", "$value": { "color": "rgba(0,230,118,0.35)", "type": "dropShadow", "x": 0, "y": 0, "blur": 24, "spread": 0 } }
    }
  },
  "light": {
    "bg":            { "$type": "color", "$value": "#F4F7F6" },
    "surface":       { "$type": "color", "$value": "#FFFFFF" },
    "surfaceRaised": { "$type": "color", "$value": "#FFFFFF" },
    "border":        { "$type": "color", "$value": "#E2E8E6" },
    "borderStrong":  { "$type": "color", "$value": "#CBD5D2" },
    "textPrimary":   { "$type": "color", "$value": "#0A0D0E" },
    "textSecondary": { "$type": "color", "$value": "#495154" },
    "textTertiary":  { "$type": "color", "$value": "#6B7479" },
    "accent":        { "$type": "color", "$value": "{global.color.volt.700}" },
    "onAccent":      { "$type": "color", "$value": "#FFFFFF" }
  }
}
